{
  "manifest_version": 3,
  "name": "LeetHub-Neo",
  "description": "Sync LeetCode submissions to GitHub with side panel tools and repository templates",
  "homepage_url": "https://github.com/legojeon/LeetHub-Neo",
  "version": "1.1.0",
  "author": "legojeon",
  "action": {
    "default_icon": "assets/thumbnail.png",
    "default_title": "Open LeetHub-Neo"
  },
  "side_panel": {
    "default_path": "src/html/sidepanel.html"
  },
  "icons": {
    "16": "assets/thumbnail.png",
    "48": "assets/thumbnail.png",
    "128": "assets/thumbnail.png"
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "tabs", "unlimitedStorage", "storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode.cn/*",
    "https://assets.leetcode.com/*",
    "https://leettranslate.coco.io.kr/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*", "https://github.com/*"],
      "js": ["src/js/interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*", "https://github.com/*"],
      "js": [
        "src/core/config/repository-files.js",
        "src/core/config/leetcode-languages.js",
        "src/core/scratchpad/scratchpad-memo.js",
        "src/core/templates/root-readme-template.js",
        "src/core/templates/topic-readme-template.js",
        "src/js/topic-index-utils.js",
        "src/js/leetcode-account-utils.js",
        "src/js/leetcode.js",
        "src/js/authorize.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"],
      "js": ["src/js/leetcode-problem.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://leetcode.com https://leetcode.cn https://assets.leetcode.com"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/js/interceptor.js"],
      "matches": ["https://leetcode.com/*", "https://leetcode.cn/*"]
    }
  ]
}
