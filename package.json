{
  "name": "leethub-kr",
  "version": "0.0.2",
  "type": "module",
  "private": true,
  "description": "Automatically sync your LeetCode submissions to GitHub",
  "scripts": {
    "setup": "npm i",
    "format": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx,css,html}\" --ignore-unknown",
    "format-test": "prettier --check \"**/*.{js,mjs,jsx,ts,tsx,css,html}\" --ignore-unknown",
    "lint": "eslint . --fix --ignore-pattern 'src/js/static/jquery-3.3.1.min.js' --ignore-pattern 'src/js/static/semantic-2.4.1.min.js'",
    "lint-test": "eslint . --color --ignore-pattern 'src/js/static/jquery-3.3.1.min.js' --ignore-pattern 'src/js/static/semantic-2.4.1.min.js'",
    "test:unit": "node tests/translation-utils.test.mjs && node tests/topic-index-utils.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3"
  }
}
